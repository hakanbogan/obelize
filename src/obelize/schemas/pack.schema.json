  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One migration between two versions of one SDK, as declarative data.\n\nThis schema states the shape of each value. PEP 440 specifiers, sorted order and every rule that\ncompares two fields are checked by `obelize pack validate`, which is authoritative.",
  "properties": {
    "changes": {
      "items": {
        "discriminator": {
          "mapping": {
            "configure_to_client": "#/$defs/ConfigureToClientChange",
            "flag_only": "#/$defs/FlagOnlyChange",
            "generative_model_calls": "#/$defs/GenerativeModelCallsChange",
            "manifest_dependency": "#/$defs/ManifestDependencyChange",
            "rename_import": "#/$defs/RenameImportChange",
            "rename_setting": "#/$defs/RenameSettingChange",
            "rewrite_call": "#/$defs/RewriteCallChange"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RenameImportChange"
          },
          {
            "$ref": "#/$defs/ConfigureToClientChange"
          },
          {
            "$ref": "#/$defs/GenerativeModelCallsChange"
          },
          {
            "$ref": "#/$defs/RewriteCallChange"
          },
          {
            "$ref": "#/$defs/RenameSettingChange"
          },
          {
            "$ref": "#/$defs/FlagOnlyChange"
          },
          {
            "$ref": "#/$defs/ManifestDependencyChange"
          }
        ]
      },
      "title": "Changes",
      "type": "array"
    },
    "from": {
      "$ref": "#/$defs/Legacy"
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "const": "python",
      "title": "Language",
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "limitations": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "match": {
      "$ref": "#/$defs/Match"
    },
    "pack_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Pack Version",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Provider",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/PackSource"
    },
    "to": {
      "$ref": "#/$defs/Target"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "pack_version",
    "provider",
    "language",
    "source",
    "from",
    "to",
    "match",
    "changes",
    "limitations"
  ],
  "title": "PackDocument",
  "type": "object"
}
