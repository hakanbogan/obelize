{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "One legacy usage the scanner resolved, or one file it could not read.",
      "properties": {
        "bail": {
          "anyOf": [
            {
              "enum": [
                "roundtrip_mismatch",
                "input_does_not_parse",
                "output_does_not_parse",
                "output_names_unresolved",
                "file_too_large",
                "runtime_unsupported",
                "legacy_version_unsupported",
                "conditional_binding",
                "module_alias_rebound",
                "model_object_escapes",
                "model_object_read_elsewhere",
                "multiple_assignments",
                "class_attr_binding",
                "receiver_unresolved",
                "receiver_method_unmapped",
                "multiple_configure_calls",
                "client_source_unresolved",
                "client_name_collision",
                "client_placement_ambiguous",
                "configure_kwargs_unsupported",
                "credentials_shape_differs",
                "alias_collision",
                "type_symbol_unmapped",
                "from_import_unmigrated_symbol",
                "local_import",
                "star_import",
                "file_not_fully_migrated",
                "repo_not_fully_migrated",
                "transitive_dependency_in_use",
                "manifest_code_mismatch",
                "manifest_pin_shape_unsupported",
                "unknown_ctor_kwarg",
                "positional_arg_ambiguous",
                "default_model_name_required",
                "generation_config_not_static",
                "safety_settings_not_static",
                "history_parts_shape_incompatible",
                "dynamic_stream_flag",
                "async_stream_await_missing",
                "unsupported_kwarg",
                "afc_semantics_differ",
                "response_shape_changed",
                "count_tokens_config_carries_semantics",
                "ctor_argument_not_portable",
                "attribute_removed",
                "flag_only_surface",
                "types_import_typing_only",
                "error_class_changed",
                "usage_unmapped",
                "configure_consumed_elsewhere"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bail"
        },
        "caused_by": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "roundtrip_mismatch",
                  "input_does_not_parse",
                  "output_does_not_parse",
                  "output_names_unresolved",
                  "file_too_large",
                  "runtime_unsupported",
                  "legacy_version_unsupported",
                  "conditional_binding",
                  "module_alias_rebound",
                  "model_object_escapes",
                  "model_object_read_elsewhere",
                  "multiple_assignments",
                  "class_attr_binding",
                  "receiver_unresolved",
                  "receiver_method_unmapped",
                  "multiple_configure_calls",
                  "client_source_unresolved",
                  "client_name_collision",
                  "client_placement_ambiguous",
                  "configure_kwargs_unsupported",
                  "credentials_shape_differs",
                  "alias_collision",
                  "type_symbol_unmapped",
                  "from_import_unmigrated_symbol",
                  "local_import",
                  "star_import",
                  "file_not_fully_migrated",
                  "repo_not_fully_migrated",
                  "transitive_dependency_in_use",
                  "manifest_code_mismatch",
                  "manifest_pin_shape_unsupported",
                  "unknown_ctor_kwarg",
                  "positional_arg_ambiguous",
                  "default_model_name_required",
                  "generation_config_not_static",
                  "safety_settings_not_static",
                  "history_parts_shape_incompatible",
                  "dynamic_stream_flag",
                  "async_stream_await_missing",
                  "unsupported_kwarg",
                  "afc_semantics_differ",
                  "response_shape_changed",
                  "count_tokens_config_carries_semantics",
                  "ctor_argument_not_portable",
                  "attribute_removed",
                  "flag_only_surface",
                  "types_import_typing_only",
                  "error_class_changed",
                  "usage_unmapped",
                  "configure_consumed_elsewhere"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caused By"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "confidence_reason": {
          "enum": [
            "direct_import_resolved",
            "alias_resolved",
            "from_import_resolved",
            "conditional_binding",
            "module_alias_rebound",
            "receiver_bound_same_scope",
            "receiver_bound_module_const",
            "receiver_bound_self_attr",
            "receiver_unresolved",
            "dynamic_access",
            "star_import",
            "star_import_candidate",
            "string_or_comment_mention",
            "mock_patch_target",
            "manifest_dependency",
            "parse_error"
          ],
          "title": "Confidence Reason",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "kind": {
          "enum": [
            "import",
            "call",
            "attribute",
            "method_call",
            "dynamic",
            "star_import",
            "text_mention",
            "manifest",
            "parse_error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "scan_status": {
          "enum": [
            "eligible",
            "needs_review",
            "unsupported",
            "not_a_usage"
          ],
          "title": "Scan Status",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "path",
        "line",
        "column",
        "kind",
        "confidence_reason",
        "symbol",
        "evidence",
        "scan_status",
        "bail",
        "caused_by"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PackRef": {
      "additionalProperties": false,
      "description": "The pack a document was produced with, as `run.json` records it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "PackRef",
      "type": "object"
    },
    "ScanCounts": {
      "additionalProperties": false,
      "description": "A summary of the findings, never a substitute for them.",
      "properties": {
        "eligible": {
          "minimum": 0,
          "title": "Eligible",
          "type": "integer"
        },
        "files_parsed": {
          "minimum": 0,
          "title": "Files Parsed",
          "type": "integer"
        },
        "files_selected": {
          "minimum": 0,
          "title": "Files Selected",
          "type": "integer"
        },
        "findings": {
          "minimum": 0,
          "title": "Findings",
          "type": "integer"
        },
        "needs_review": {
          "minimum": 0,
          "title": "Needs Review",
          "type": "integer"
        },
        "not_a_usage": {
          "minimum": 0,
          "title": "Not A Usage",
          "type": "integer"
        },
        "unsupported": {
          "minimum": 0,
          "title": "Unsupported",
          "type": "integer"
        }
      },
      "required": [
        "files_selected",
        "files_parsed",
        "findings",
        "eligible",
        "needs_review",
        "unsupported",
        "not_a_usage"
      ],
      "title": "ScanCounts",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `findings.json` document, which `obelize scan --json` also prints.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/ScanCounts"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "obelize_version": {
      "title": "Obelize Version",
      "type": "string"
    },
    "packs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PackRef"
      },
      "title": "Packs",
      "type": "array"
    }
  },
  "required": [
    "obelize_version",
    "packs",
    "counts",
    "findings"
  ],
  "title": "FindingsDocument",
  "type": "object"
}
