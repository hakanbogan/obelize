[project]
name = "clear-fixture"
version = "0.1.0"
dependencies = [
  "google-genai>=1.55",
  "requests>=2.31",
]

[tool.poetry.group.test.dependencies]
google-genai = ">=1.55"
pytest = "^8.3"

[tool.uv]
dev-dependencies = [
  "google-genai>=1.55",
]

[tool.pdm.dev-dependencies]
lint = ["google-genai>=1.55"]

[tool.hatch.envs.default]
dependencies = ["google-genai>=1.55"]

[tool.hatch.envs.default.scripts]
lock = "pip install google-generativeai==0.8.6"
